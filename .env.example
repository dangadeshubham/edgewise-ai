# =============================================================================
# EDGEWISE AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Device Identity ---
DEVICE_ID=edge-device-001
DEVICE_NAME=Site-A Field Terminal
DEVICE_SITE=site-alpha

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SQLite Database ---
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/edgewise.db

# --- Qdrant Edge (Local) ---
EDGE_MUTABLE_SHARD_PATH=./data/qdrant_edge/mutable
EDGE_IMMUTABLE_SHARD_PATH=./data/qdrant_edge/immutable
EDGE_VECTOR_NAME=dense
EDGE_SPARSE_VECTOR_NAME=sparse_bm25

# --- Qdrant Server/Cloud (Remote) ---
QDRANT_SERVER_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=edgewise-knowledge

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# --- Embedding Model ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Do NOT hardcode dimension. It is read from the model at startup.

# --- Document Ingestion ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.txt,.md,.json,.docx
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Synchronization ---
SYNC_BATCH_SIZE=50
SYNC_RETRY_MAX=5
SYNC_RETRY_BASE_DELAY_SECONDS=2.0
SYNC_INTERVAL_SECONDS=300

# --- Data Placement Policy ---
DEFAULT_SENSITIVITY=internal
SYNC_ELIGIBLE_SENSITIVITIES=public,internal
LOCAL_ONLY_SENSITIVITIES=confidential,restricted

# --- File Storage ---
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
