# =============================================================================
# EDGEWISE AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure for your deployment environment.
#   cp .env.example .env
#
# CRITICAL:
# - NEVER commit the .env file to version control.
# - NEVER hardcode production secrets or tokens.
# =============================================================================

# --- Application Identity & Version ---
APP_VERSION=0.1.0
DEVICE_ID=edge-device-001
DEVICE_NAME=Site-A Field Terminal
DEVICE_SITE=site-alpha
AUTO_REGISTER_LOCAL_DEVICE=false

# --- Exposed Ports & Networking ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- SQLite Database Storage ---
# For container deployment: /app/data/sqlite/edgewise.db
# For local development: ./data/sqlite/edgewise.db
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/edgewise.db

# --- Qdrant Edge (Embedded In-Process Storage) ---
EDGE_MUTABLE_SHARD_PATH=./data/qdrant_edge/mutable
EDGE_IMMUTABLE_SHARD_PATH=./data/qdrant_edge/immutable
EDGE_VECTOR_NAME=dense
EDGE_SPARSE_VECTOR_NAME=sparse_bm25

# --- Qdrant Server / Cloud (Central Mirror) ---
# When running inside Docker Compose network, use service hostname: http://qdrant-server:6333
# When running locally outside container, use: http://localhost:6333
QDRANT_SERVER_URL=http://qdrant-server:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=edgewise-knowledge

# --- Ollama (Local Large Language Model) ---
# When running inside Docker Compose network, use service hostname: http://ollama:11434
# When running locally outside container, use: http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# --- Local Embedding Model ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Vector dimension is dynamically detected from the embedding model at startup.

# --- Document Ingestion & Storage Limits ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.txt,.md,.json,.docx
CHUNK_SIZE=512
CHUNK_OVERLAP=64
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# --- Synchronization Engine ---
SYNC_BATCH_SIZE=50
SYNC_RETRY_MAX=5
SYNC_RETRY_BASE_DELAY_SECONDS=2.0
SYNC_INTERVAL_SECONDS=300

# --- Data Placement & Privacy Policy ---
DEFAULT_SENSITIVITY=internal
SYNC_ELIGIBLE_SENSITIVITIES=public,internal
LOCAL_ONLY_SENSITIVITIES=confidential,restricted

# --- Resource Allocations (Docker Deployment) ---
BACKEND_CPU_LIMIT=2.0
BACKEND_MEMORY_LIMIT=2G
OLLAMA_CPU_LIMIT=4.0
OLLAMA_MEMORY_LIMIT=4G
QDRANT_MEMORY_LIMIT=1G
